# Copy to .env and edit, then restart the app. Every value below is also settable
# at runtime from the Settings page (which wins); these are the starting defaults.
#
# Nothing in this file is a secret: the real .env is git-ignored, and a fresh
# checkout of this project has no target until you point it at one on purpose.

# --- Authentication: pick ONE -------------------------------------------------
# Recommended — mint an API token in the Platform web UI and paste it here.
EXA_API_TOKEN=

# Fallback password login. Usually refused by platform-auth; keep the token.
# EXA_USER=
# EXA_PASSWORD=

# --- Target workspace (REQUIRED) ---------------------------------------------
# Deliberately blank: a compiled-in lab target turns into a portability bug the
# moment this folder is copied to another site. The app asks for these instead
# of failing obscurely.
EXA_GATEWAY=
EXA_ORG=
EXA_WORKSPACE=

# Keycloak URL if it is not served from the gateway host.
# EXA_KEYCLOAK=
# Client id; defaults to _<org>-api when unset.
# EXA_CLIENT_ID=

# --- Interface ---------------------------------------------------------------
EXA_UI_LANG=en            # en | ja
EXA_UI_THEME=dark         # dark | light
# The app listens on 0.0.0.0:9200 and stores run history in ./creations.db.
# Neither is configurable by design; change them in app.py if you must.

# --- Demo: run the entire flow with no live Exastro --------------------------
# EXA_MOCK=true

# --- Advanced ---------------------------------------------------------------
# Menu names and version ids. Leave these alone unless the install differs from
# Exastro ITA v2.8 Ansible, or a value has to be a *different* one there. Every
# id below can be checked from the Settings page instead — it lists what the
# connected environment actually offers.
# EXA_MOVEMENT_MENU=movement_list_ansible_role
# EXA_ROLE_LINK_MENU=movement_role_link
# EXA_FILE_LINK_MENU=file_link
# EXA_SUBST_MENU=subst_value_auto_reg_setting_ansible_role
# EXA_ROLE_MENU=role_management_ansible_role
# EXA_EXECUTE_MENU=
# EXA_EXEC_ENV=
# EXA_ADMIN_ROLE=          # "Define Role for each configuration"; blank = the connected account
# EXA_SHEET_TYPE_ID=1
# EXA_MENU_GROUP_INPUT_ID=502
# EXA_MENU_GROUP_SUBST_ID=503
# EXA_MENU_GROUP_REF_ID=504
# EXA_SUBST_METHOD_ID=1
# EXA_HOST_FORMAT_ID=1
# EXA_ORCHESTRATOR_ID=
# EXA_VAR_TIMEOUT=120
# EXA_VAR_INTERVAL=5
# EXA_TIMEOUT=30
# EXA_AUTH_TIMEOUT=90

# --- Settings page PIN (optional) --------------------------------------------
# Overrides the stored PIN so a lost PIN cannot lock you out of your own tool.
# EXA_SETTINGS_PIN=

# --- Local file locations -----------------------------------------------------
# Profile store (Settings page). The test suite points this at a temp file.
# EXA_SETTINGS_DB=settings.db
# Flask session signing key: either the value itself, or the file to keep it in.
# EXA_SECRET_KEY=
# EXA_SECRET_FILE=flask_secret.key
